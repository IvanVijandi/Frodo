# Configuración de base de datos Vectorial
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
VECTOR_DIM=768

# Configuración de Modelos (providers: ollama, google, openai, etc.)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_K=3
HF_HOME=/root/.cache/huggingface

# Nombres de Modelos para Ollama
LLM_MODEL=qwen3.5:4b
EMBEDDING_MODEL=embeddinggemma
# EVALUATOR_MODEL=qwen3.5:4b (opcional, si no se especifica usa LLM_MODEL)

# URIs locales (Ollama)
OLLAMA_URI=http://localhost:11434

# API Keys (si se usa google, openai, voyage, etc.)
OPENAI_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Base de datos Relacional (PostgreSQL)
POSTGRES_USER=maria_user
POSTGRES_PASSWORD=maria_pass
POSTGRES_DB=maria_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://maria_user:maria_pass@postgres:5432/maria_db

# pgAdmin GUI
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin123

